# Copy these settings into backend/.env; never put the token in frontend code.
# Select payhero for real payouts or oneapp for simulated app credits.
WITHDRAWAL_PROVIDER=payhero
# OneApp keys belong to one account. Withdraw to that account's phone number.
ONEAPP_BASE_URL=https://andy.douradoclassymotors.com/api
ONEAPP_API_KEY=

PAYHERO_ENABLED=false
PAYHERO_AUTH_TOKEN=
PAYHERO_CHANNEL_ID=
# Public HTTPS origin of this backend, e.g. https://api.example.com
PAYHERO_CALLBACK_BASE_URL=

# Payout credentials are configured separately from collection credentials.
PAYHERO_PAYOUT_ENABLED=false
PAYHERO_PAYOUT_AUTH_TOKEN=
PAYHERO_PAYOUT_ACCOUNT_ID=
PAYHERO_PAYOUT_NETWORK_CODE=
# Confirm your payout account's API host: https://api.payhero.africa or https://api.finoq.africa
PAYHERO_PAYOUT_BASE_URL=
